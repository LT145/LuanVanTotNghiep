// ===========================================================
// 📦 Prisma Schema — Hệ thống bán hàng (CHQA)
// ✅ Promotion theo Product + ColorVariant + Size
// ✅ Return/Exchange (đổi/trả) có audit: approvedAt/approvedById, rejectedAt/rejectedById
// ===========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================
// ENUMS
// ===========================================================
enum Role {
  USER
  ADMIN
  MANAGER
  SHIPPER
}

enum Gender {
  MALE
  FEMALE
  UNISEX
}

enum UserGender {
  MALE
  FEMALE
  OTHER
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPING
  COMPLETED
  CANCELLED
  SHIPPINGFAILED
}

enum PaymentMethod {
  COD
  ZALOPAY
  VNPAY
  PAYPAL
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ShippingMethod {
  STANDARD
  EXPRESS
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

// ✅ Promotion
enum PromotionScope {
  ALL_SIZES
  SPECIFIC_SIZES
}

enum PromotionStatus {
  SCHEDULED
  ACTIVE
  EXPIRED
  DISABLED
}

// ✅ Return/Exchange
enum ReturnType {
  EXCHANGE
  RETURN
  REFUND
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  RECEIVED
  EXCHANGED
  REFUNDED
  CANCELLED
}

// ===========================================================
// USER & ADDRESS
// ===========================================================
model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  password       String
  role           Role            @default(USER)
  createdAt      DateTime        @default(now())
  status         UserStatus      @default(ACTIVE)
  gender         UserGender?
  birthDate      DateTime?

  addresses      UserAddress[]
  favorites      Favorite[]
  cart           Cart?
  orders         Order[]
  recentlyViewed RecentlyViewed[]
  reviews        Review[]

  // ✅ Return requests created by user
  returnRequests ReturnRequest[] @relation("ReturnCreatedByUser")

  // ✅ audit: admin who approved/rejected
  approvedReturns ReturnRequest[] @relation("ReturnApprovedBy")
  rejectedReturns ReturnRequest[] @relation("ReturnRejectedBy")
}

model UserAddress {
  id             String   @id @default(cuid())
  userId         String
  label          String?
  recipientName  String
  recipientPhone String
  address        String
  province       String?
  ward           String?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// ===========================================================
// CATEGORY & PRODUCT
// ===========================================================
model Category {
  id       String   @id @default(cuid())
  name     String
  slug     String   @unique
  imageUrl String?
  gender   Gender

  products Product[]
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  basePrice   Float    @default(0)
  costPrice   Float    @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  viewCount   Int      @default(0)
  soldCount   Int      @default(0)

  keywords    String[] @default([])

  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])

  images         ProductImage[]
  variantColors  ProductVariantColor[]
  favorites      Favorite[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  recentlyViewed RecentlyViewed[]
  reviews        Review[]

  promotions     Promotion[]

  @@index([categoryId])
  @@index([isActive])
}

model ProductVariantColor {
  id        String   @id @default(cuid())
  color     String
  productId String
  createdAt DateTime @default(now())

  product    Product              @relation(fields: [productId], references: [id])
  images     ProductImage[]
  sizes      ProductVariantSize[]
  promotions Promotion[]

  @@index([productId])
}

model ProductVariantSize {
  id             String   @id @default(cuid())
  size           String
  price          Float
  stock          Int      @default(0)
  colorVariantId String
  createdAt      DateTime @default(now())

  colorVariant ProductVariantColor @relation(fields: [colorVariantId], references: [id])

  promotions   PromotionSize[]

  @@index([colorVariantId])
}

model ProductImage {
  id             String   @id @default(cuid())
  url            String
  isMain         Boolean  @default(false)
  productId      String?
  variantColorId String?
  createdAt      DateTime @default(now())

  product      Product?             @relation(fields: [productId], references: [id])
  colorVariant ProductVariantColor? @relation(fields: [variantColorId], references: [id])

  @@index([productId])
  @@index([variantColorId])
}

// ===========================================================
// ✅ PROMOTION
// ===========================================================
model Promotion {
  id             String          @id @default(cuid())

  productId      String
  colorVariantId String

  scope          PromotionScope  @default(ALL_SIZES)
  promotionPrice Float
  startDate      DateTime
  endDate        DateTime

  status         PromotionStatus @default(SCHEDULED)
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  product      Product             @relation(fields: [productId], references: [id])
  colorVariant ProductVariantColor @relation(fields: [colorVariantId], references: [id])
  sizes        PromotionSize[]

  @@index([productId])
  @@index([colorVariantId])
  @@index([startDate, endDate])
  @@index([isActive])
}

model PromotionSize {
  id          String   @id @default(cuid())
  promotionId String
  sizeId      String
  price       Float
  createdAt   DateTime @default(now())

  promotion Promotion          @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  size      ProductVariantSize @relation(fields: [sizeId], references: [id], onDelete: Cascade)

  @@index([promotionId])
  @@index([sizeId])
  @@unique([promotionId, sizeId])
}

// ===========================================================
// FAVORITE
// ===========================================================
model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

// ===========================================================
// CART
// ===========================================================
model Cart {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id])
  items CartItem[]

  @@unique([userId])
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  color     String?
  size      String?
  quantity  Int      @default(1)
  price     Float    @default(0)
  createdAt DateTime @default(now())

  cart    Cart    @relation(fields: [cartId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([cartId])
  @@index([productId])
}

// ===========================================================
// ORDER
// ===========================================================
model Order {
  id              String         @id @default(cuid())
  userId          String
  totalAmount     Float
  shippingFee     Float          @default(0)

  status          OrderStatus    @default(PENDING)
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus  @default(PENDING)
  shippingMethod  ShippingMethod @default(STANDARD)

  recipientName   String
  recipientPhone  String
  shippingAddress String
  province        String
  ward            String
  note            String?

  deliveredAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user    User          @relation(fields: [userId], references: [id])
  items   OrderItem[]
  history OrderHistory[]

  // ✅ return requests for this order
  returnRequests ReturnRequest[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderHistory {
  id        String     @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  imageUrl  String?
  createdAt DateTime   @default(now())

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  color     String?
  size      String?
  quantity  Int
  price     Float
  createdAt DateTime @default(now())

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  // ✅ return items referencing this order item
  returnItems ReturnItem[]

  @@index([orderId])
  @@index([productId])
}

// ===========================================================
// ✅ RETURN / EXCHANGE
// ===========================================================
model ReturnRequest {
  id        String       @id @default(cuid())

  // link
  userId    String
  orderId   String

  type      ReturnType
  status    ReturnStatus @default(PENDING)

  // user content
  reason    String
  note      String?
  mediaUrls String[]     @default([])

  // admin action / audit
  adminNote     String?
  approvedAt    DateTime?
  approvedById  String?
  rejectedAt    DateTime?
  rejectedById  String?

  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // relations
  user      User  @relation("ReturnCreatedByUser", fields: [userId], references: [id])
  order     Order @relation(fields: [orderId], references: [id])
  items     ReturnItem[]

  approvedBy User? @relation("ReturnApprovedBy", fields: [approvedById], references: [id])
  rejectedBy User? @relation("ReturnRejectedBy", fields: [rejectedById], references: [id])

  @@index([userId])
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
  @@index([approvedById])
  @@index([rejectedById])
}

model ReturnItem {
  id          String   @id @default(cuid())

  returnId    String
  orderItemId String
  quantity    Int

  createdAt   DateTime @default(now())

  returnRequest ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@index([orderItemId])
  @@unique([returnId, orderItemId])
}

// ===========================================================
// STORE SETTINGS
// ===========================================================
model StoreSetting {
  id                       String   @id @default(cuid())
  storeName                String   @default("Cửa hàng CHQA")
  address                  String
  latitude                 Float?
  longitude                Float?
  lowStockThreshold        Int      @default(5)
  normalShippingFee        Float    @default(15000)
  expressRatePerKm         Float    @default(8000)
  maxExpressDistanceKm     Float    @default(30)
  enableExpress            Boolean  @default(true)
  enableFreeShipByTotal    Boolean  @default(false)
  enableFreeShipByQuantity Boolean  @default(false)
  freeShipMinTotal         Float?   @default(500000)
  freeShipMinQuantity      Int?     @default(3)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

// ===========================================================
// RECENTLY VIEWED
// ===========================================================
model RecentlyViewed {
  id        String   @id @default(cuid())
  userId    String
  productId String
  viewedAt  DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@index([viewedAt])
}

// ===========================================================
// REVIEW
// ===========================================================
model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String

  rating    Int
  content   String?
  images    String[] @default([])

  isApproved Boolean @default(true)
  adminReply String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([userId])
  @@unique([userId, productId])
}
